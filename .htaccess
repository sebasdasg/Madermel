# Activa el motor de reescritura
RewriteEngine On

# Oculta la carpeta .git y el .gitignore: el despliegue desde GitHub los deja dentro de public_html
RewriteRule (^|/)\.git - [R=404,L]

# Reescribe URLs para que no incluyan las extensiones .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^.]+)$ $1.html [L,QSA]

# CSS y JS: el navegador debe revalidar siempre (si no cambió, responde 304 sin descargar).
# Evita que los visitantes vean estilos o menús viejos después de subir cambios.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
